---
import DetailLayout from "../../layouts/DetailLayout.astro";
import { getProjectBySlug } from "../../data/site-data";

const project = getProjectBySlug("aumarche");
if (!project) {
  throw new Error("Project data not found for 'aumarche'");
}

const { title, description, year, tags = [], links = [], tools, language } = project;

const mediaEntries = Object.entries(
  import.meta.glob<string>(
    "/public/commercial/aumarche/*.{png,jpg,jpeg,JPG,JPEG,webp,gif}",
    {
      eager: true,
      query: "?url",
      import: "default",
    },
  ),
);

type MediaItem = {
  url: string;
  fileName: string;
  stem: string;
};

const mediaItems: MediaItem[] = mediaEntries
  .map(([path, url]) => {
    const fileName = path.split("/").pop() ?? "";
    const stem = fileName.replace(/\.[^.]+$/, "");
    const publicUrl = url.startsWith("/public/") ? url.slice("/public".length) : url;
    return { url: publicUrl, fileName, stem };
  })
  .sort((a, b) => a.fileName.localeCompare(b.fileName, undefined, { numeric: true }));

const byStem = (stem: string) => mediaItems.find((m) => m.stem === stem);

type ScreenSpec = {
  stem: string;
  caption: string;
  alt: string;
};

function screensFrom(specs: ScreenSpec[]) {
  return specs.flatMap((spec) => {
    const item = byStem(spec.stem);
    return item ? [{ ...item, caption: spec.caption, alt: spec.alt }] : [];
  });
}

const appScreens = screensFrom([
  {
    stem: "app1",
    caption: "Explore — fashion and lifestyle feed",
    alt: `${title} main feed with full-screen lifestyle post`,
  },
  {
    stem: "app5",
    caption: "Discover — post and linked products",
    alt: `${title} post detail with comments and linked products`,
  },
  {
    stem: "app3",
    caption: "Shop — product detail",
    alt: `${title} product detail with price and media pager`,
  },
  {
    stem: "app4",
    caption: "Buy — shopping bag and saved items",
    alt: `${title} shopping bag with shipping and totals`,
  },
  {
    stem: "app2",
    caption: "Be your own boss — seller inventory",
    alt: `${title} seller product list with sizes and stock`,
  },
  {
    stem: "app6",
    caption: "Tell your story — creator profile",
    alt: `${title} creator profile with feeds and products`,
  },
  {
    stem: "app7",
    caption: "Manage — shop operations",
    alt: `${title} shop management sheet for posts, orders, and wallet`,
  },
]);

const profileScreens = screensFrom([
  {
    stem: "app_profile_1",
    caption: "Profile header — Feeds and Reposts spacing",
    alt: `${title} profile header with refined spacing around Feeds and Reposts`,
  },
  {
    stem: "app_profile_2",
    caption: "Profile header — grid alignment",
    alt: `${title} profile header study showing grid-aligned profile controls`,
  },
]);

const walkthroughScreens = [appScreens[0], appScreens[2], appScreens[4]];
const supportingScreens = [appScreens[1], appScreens[3], appScreens[5], appScreens[6]];

const campaignProcess = [
  "Content writing",
  "Wireframe",
  "Interaction",
  "Mockup",
  "Reiteration",
  "Prototype",
  "Finalization",
  "Publication",
];

const articleCards = screensFrom([
  {
    stem: "instagram-article-01",
    caption: "Article campaign — cover",
    alt: "Cover card for Digital Fashion: Dawn of a Post Product World",
  },
  {
    stem: "instagram-article-02",
    caption: "Article campaign — editorial context",
    alt: "Editorial quote card about virtual fashion",
  },
  {
    stem: "instagram-article-03",
    caption: "Article campaign — The Fabricant and digi-couture",
    alt: "Graphic card featuring The Fabricant and a digital-only dress",
  },
  {
    stem: "instagram-article-04",
    caption: "Article campaign — digital art",
    alt: "Quote card about traceable and tradeable digital art",
  },
  {
    stem: "instagram-article-05",
    caption: "Article campaign — Gucci Virtual 25",
    alt: "Graphic card about Gucci Virtual 25 digital sneakers",
  },
  {
    stem: "instagram-article-06",
    caption: "Article campaign — fashion commentary",
    alt: "Editorial quote card about virtual fashion",
  },
  {
    stem: "instagram-article-07",
    caption: "Article campaign — read more",
    alt: "Au Marché call-to-action card for the article",
  },
]);

const readerReviewCards = screensFrom([
  {
    stem: "instagram-reader-review-01",
    caption: "Reader-review campaign — cover",
    alt: "Cover card for reader reviews of Digital Fashion",
  },
  {
    stem: "instagram-reader-review-02",
    caption: "Reader-review campaign — article feature",
    alt: "Feature card about innovation and extravagance in digital fashion",
  },
  {
    stem: "instagram-reader-review-03",
    caption: "Reader-review campaign — response one",
    alt: "Reader response card about technology and fashion",
  },
  {
    stem: "instagram-reader-review-04",
    caption: "Reader-review campaign — response two",
    alt: "Reader response card about digital couture and conceptual art",
  },
  {
    stem: "instagram-reader-review-05",
    caption: "Reader-review campaign — response three",
    alt: "Reader response card about digital fashion and technology",
  },
  {
    stem: "instagram-reader-review-06",
    caption: "Reader-review campaign — response four",
    alt: "Reader response card about virtual shopping and digital design",
  },
  {
    stem: "instagram-reader-review-07",
    caption: "Reader-review campaign — read more",
    alt: "Au Marché call-to-action card for the reader reviews",
  },
]);
---

<DetailLayout {title} {description} {year} {tags} {links} {tools} {language}>
  <nav class="aum-toc" aria-label="Case study sections">
    <ol>
      <li><a href="#overview">Overview</a></li>
      <li><a href="#walkthrough">App walkthrough</a></li>
      <li><a href="#design-studies">Design studies</a></li>
      <li><a href="#reflections">Next questions</a></li>
      <li><a href="#campaigns">Instagram campaigns</a></li>
    </ol>
  </nav>

  <section class="text aum-section" id="overview">
    <h2 class="section">I. PROJECT OVERVIEW</h2>
    <h3 class="subject">THE MARKETPLACE</h3>
    <p class="text">
      Au Marché is a social-commerce concept connecting businesses, creators, and
      customers. Fashion and lifestyle content sits alongside shoppable products,
      creating a continuous path from discovery to purchase.
    </p>
    <h3 class="subject">MY CONTRIBUTION</h3>
    <p class="text">
      I worked as a UI designer during a short internship, developing mobile app screens
      in Figma with a small design and development team. The work was interface-focused;
      this case study does not claim measured product outcomes.
    </p>
  </section>

  <dl class="aum-glance" aria-label="Project at a glance">
    <div class="aum-glance__item">
      <dt>ROLE</dt>
      <dd>UI designer · internship</dd>
    </div>
    <div class="aum-glance__item">
      <dt>PRODUCT</dt>
      <dd>Mobile social-commerce app</dd>
    </div>
    <div class="aum-glance__item">
      <dt>TOOL</dt>
      <dd>Figma</dd>
    </div>
    <div class="aum-glance__item">
      <dt>DURATION</dt>
      <dd>Approximately 3 months</dd>
    </div>
  </dl>

  <section class="text aum-section" id="walkthrough">
    <h2 class="section">II. APP WALKTHROUGH</h2>
    <h3 class="subject">FROM DISCOVERY TO SELLER TOOLS</h3>
    <p class="text">
      Three views show the product’s two sides: a buyer discovers content in the feed,
      explores a product, and a seller manages inventory. The consistent visual language
      connects these parts of the concept.
    </p>
    <div
      class="gallery gallery--docs aum-screens aum-walkthrough"
      role="list"
      aria-label="Au Marché app walkthrough: feed, product, and seller inventory"
    >
      {
        walkthroughScreens.map((item) => (
          <figure class="detailImage aum-screen" role="listitem">
            <div class="aum-device">
              <img src={item.url} alt={item.alt} loading="lazy" decoding="async" />
            </div>
            <figcaption class="aum-caption">{item.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="text aum-section" id="design-studies">
    <h2 class="section">III. SUPPORTING DESIGN STUDIES</h2>
    <h3 class="subject">ADDITIONAL APP SCREENS</h3>
    <p class="text">
      Further explorations cover the post detail, shopping bag, creator profile, and
      shop-management views.
    </p>
    <div
      class="gallery gallery--docs aum-screens"
      role="list"
      aria-label="Additional Au Marché mobile app interface studies"
    >
      {
        supportingScreens.map((item) => (
          <figure class="detailImage aum-screen" role="listitem">
            <div class="aum-device">
              <img src={item.url} alt={item.alt} loading="lazy" decoding="async" />
            </div>
            <figcaption class="aum-caption">{item.caption}</figcaption>
          </figure>
        ))
      }
    </div>
    <h3 class="subject">PROFILE HEADER: GRID &amp; SPACING</h3>
    <p class="text">
      I refined the existing profile interface by applying a consistent grid and spacing
      rhythm to the Feeds and Reposts controls and surrounding profile actions. The
      improved alignment makes the controls easier to scan and brings the screen into
      closer visual and systemic consistency with the rest of the app.
    </p>
    <div
      class="gallery gallery--docs aum-screens"
      role="list"
      aria-label="Two Au Marché profile header design options"
    >
      {
        profileScreens.map((item) => (
          <figure class="detailImage aum-screen" role="listitem">
            <div class="aum-device">
              <img src={item.url} alt={item.alt} loading="lazy" decoding="async" />
            </div>
            <figcaption class="aum-caption">{item.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="text aum-section" id="reflections">
    <h2 class="section">IV. DESIGN REFLECTIONS</h2>
    <h3 class="subject">QUESTIONS FOR A NEXT ITERATION</h3>
    <div class="aum-reflection-copy">
      <p class="text">
        The interface studies also surfaced areas to explore in a next iteration:
      </p>
      <ul class="aum-reflections">
        <li>
          Define a clear horizontal swipe affordance for multi-photo posts without
          interfering with vertical feed scrolling.
        </li>
        <li>
          Explore saved drafts in the creation flow so unfinished work can be resumed.
        </li>
      </ul>
      <p class="text">
        These are follow-up design questions, not features represented as shipped or
        validated.
      </p>
    </div>
  </section>

  <section class="text aum-section" id="campaigns">
    <h2 class="section">V. INSTAGRAM GRAPHIC CAMPAIGNS</h2>
    <h3 class="subject">ARTICLE &amp; READER-REVIEW CARDS</h3>
    <p class="text">
      A one-month visual design project adapted an article on digital fashion and its
      reader reviews into two Instagram card sequences.
    </p>
    <h3 class="subject">DESIGN PROCESS</h3>
    <ol class="aum-process" aria-label="Instagram card design process">
      {campaignProcess.map((step) => <li>{step}</li>)}
    </ol>
    <h3 class="subject">DIGITAL FASHION ARTICLE</h3>
    <div
      class="gallery gallery--docs aum-screens aum-campaigns"
      role="list"
      aria-label="Instagram cards promoting the digital fashion article"
    >
      {
        articleCards.map((item) => (
          <figure class="detailImage aum-screen aum-campaign-card" role="listitem">
            <img src={item.url} alt={item.alt} loading="lazy" decoding="async" />
            <figcaption class="aum-caption">{item.caption}</figcaption>
          </figure>
        ))
      }
    </div>
    <h3 class="subject">READER REVIEWS</h3>
    <div
      class="gallery gallery--docs aum-screens aum-campaigns"
      role="list"
      aria-label="Instagram cards featuring reader reviews"
    >
      {
        readerReviewCards.map((item) => (
          <figure class="detailImage aum-screen aum-campaign-card" role="listitem">
            <img src={item.url} alt={item.alt} loading="lazy" decoding="async" />
            <figcaption class="aum-caption">{item.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>
</DetailLayout>

<style>
  .aum-glance {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-md);
    margin: var(--space-lg) 0;
    padding: clamp(1rem, 2vw, 1.5rem);
    border: 1px solid color-mix(in srgb, var(--color-text) 16%, transparent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--color-surface) 72%, transparent);
  }

  .aum-glance__item {
    min-width: 0;
    padding: var(--space-md);
    border-left: 3px solid #cf2344;
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-text) 3%, transparent);
  }

  .aum-glance__item dt {
    margin-bottom: var(--space-xs);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .aum-glance__item dd {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .aum-toc {
    position: sticky;
    top: 0;
    z-index: 5;
    margin-inline: calc(-1 * var(--card-padding));
    padding: var(--space-sm) var(--card-padding);
    background: color-mix(in srgb, var(--color-page-background) 90%, transparent);
    border-block: 1px solid color-mix(in srgb, var(--color-text) 12%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .aum-toc ol {
    display: flex;
    gap: clamp(var(--space-md), 3vw, var(--space-xl));
    width: 100%;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: thin;
  }

  .aum-toc a {
    display: block;
    padding-block: var(--space-xs);
    font-size: var(--text-sm);
    white-space: nowrap;
    text-decoration: none;
  }

  .aum-toc a:hover,
  .aum-toc a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .aum-toc a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .aum-section {
    scroll-margin-top: 5rem;
  }

  .aum-section > h2.section {
    margin: 0 0 var(--space-md);
  }

  .aum-section > h3.subject {
    margin: 0;
  }

  .aum-process {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: var(--space-md) 0;
    padding: 0;
    list-style: none;
  }

  .aum-process li {
    padding: 0.35rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--color-text) 16%, transparent);
    border-radius: 999px;
    font-size: var(--text-xs);
  }

  .aum-reflections {
    display: grid;
    gap: var(--space-sm);
    margin: var(--space-md) 0;
    padding-left: 1.25rem;
    line-height: 1.6;
  }

  .aum-reflection-copy {
    display: grid;
    gap: var(--space-lg);
  }

  .aum-screen {
    width: 100%;
    min-width: 0;
    margin: 0;
  }

  .aum-device {
    padding: clamp(5px, 0.7vw, 9px);
    overflow: hidden;
    background: #18191d;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: clamp(18px, 2vw, 28px);
    box-shadow:
      0 18px 36px rgba(20, 20, 24, 0.16),
      0 3px 8px rgba(20, 20, 24, 0.1);
  }

  .aum-device img {
    max-width: 100%;
    height: auto;
    border-radius: 16px;
    background: #fff;
  }

  .gallery.aum-screens {
    width: 100%;
    margin-inline: 0 auto;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .gallery.aum-walkthrough {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .gallery.aum-campaigns {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .aum-campaign-card img {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 10px;
    object-fit: cover;
  }

  @media (min-width: 992px) {
    section.text > .gallery.gallery--docs.aum-screens {
      grid-column: 2;
    }

    section.text > .aum-reflection-copy {
      grid-column: 2;
    }
  }

  .aum-caption {
    margin-top: 0.4rem;
    font-size: 0.7rem;
    line-height: 1.3;
    color: var(--color-text);
    opacity: 0.72;
  }

  @media (max-width: 767px) {
    .aum-glance {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .aum-glance__item:nth-child(n + 3) {
      grid-column: 1 / -1;
    }

    .gallery.aum-campaigns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .gallery.aum-walkthrough {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
